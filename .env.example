# minicli 本地配置模板（.env.example）
# ---------------------------------------------------------------
# 说明：.env.example 仅是 @root 个人使用的模板配置文件，供快速复制参考；
# 真正生效的配置文件是项目根目录 .env（.env 已被 .gitignore 排除，不入库）。
# 使用：cp .env.example .env，再填写真实值；或在现有 .env 中直接增删改。
# 读取规则：Config 优先读 .env；同名系统环境变量兜底；再回退代码内默认值。

# ============ 1. DeepSeek / LLM 配置 ============
# DeepSeek API 密钥（必填；真实密钥只放 .env，禁止提交入库）。
DEEPSEEK_API_KEY=
# 模型名（必填），如 deepseek-v4-flash。
DEEPSEEK_MODEL=deepseek-v4-flash
# OpenAI 兼容 API 基础地址（选填），默认 DeepSeek 官方地址。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============ 2. 网络与超时 ============
# 与 DeepSeek API 建立 TCP 连接的超时秒数（选填，默认 10）。
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
# 读取流式响应的超时秒数（选填，默认 120；思考模式/长回答建议不小于 60）。
DEEPSEEK_READ_TIMEOUT_SECONDS=120

# ============ 3. Agent 主循环 ============
# ReAct 最大循环步数（选填，默认 50；超过仍未得到最终回答会报错）。
MINICLI_AGENT_MAX_STEPS=50
# 同一轮工具调用的最大并发数（选填，默认 4）。
MINICLI_AGENT_MAX_CONCURRENCY=4
# 工具观察结果回填给 LLM 前截断的字符数（选填，默认 4000，防止上下文撑爆）。
MINICLI_AGENT_MAX_OBSERVATION_CHARS=4000

# ============ 5. 智谱 GLM 联网搜索（可选） ============
# 智谱开放平台 API Key（open.bigmodel.cn → API Keys 页面获取）。
# 配置后 minicli 注册 glm_web_search 工具；留空则不注册该工具。
GLM_API_KEY=
